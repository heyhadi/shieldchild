<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ShieldChild" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F5F6F1</item>
    </style>

    <style name="Theme.ShieldChild.CurfewLock" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@color/overlay_scrim</item>
        <item name="android:statusBarColor">@color/overlay_scrim</item>
        <item name="android:navigationBarColor">@color/overlay_scrim</item>
        <item name="android:showWhenLocked">true</item>
        <item name="android:turnScreenOn">true</item>
    </style>
</resources>
